extends Area3D
class_name WeaponPickup

@export var weapon_to_give: Weapon
@export var pickup_prompt: String = "按E拾取武器"

var player_in_range: Player = null
var picked_up: bool = false

func _ready() -> void:
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)

func _process(_delta: float) -> void:
	if picked_up or player_in_range == null:
		return
	if Input.is_action_just_pressed("interact"):
		pickup_weapon()

func _on_body_entered(body: Node3D) -> void:
	if body is Player:
		player_in_range = body as Player

func _on_body_exited(body: Node3D) -> void:
	if body is Player:
		player_in_range = null

func pickup_weapon() -> void:
	if weapon_to_give == null:
		return
	var weapon_instance: Weapon = weapon_to_give.duplicate() as Weapon
	add_child(weapon_instance)
	weapon_instance.bind_player(player_in_range)
	player_in_range.equip_weapon(weapon_instance)
	picked_up = true
	visible = false
