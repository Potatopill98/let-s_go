extends RepairTask
class_name FinalEscapeTask

func _on_task_complete() -> void:
	# 显示胜利画面，Demo结束
	get_tree().paused = true
	var win_label: Label = Label.new()
	win_label.text = "逃生成功！Demo通关"
	win_label.scale = Vector3(5, 5, 5)
	win_label.position = Vector2(800, 500)
	get_tree().root.add_child(win_label)
