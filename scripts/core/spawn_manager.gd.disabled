extends Node3D
class_name SpawnManager

@export var monster_scene: PackedScene
@export var spawn_point_path: NodePath
@export var base_spawn_interval: float = 10.0
@export var min_spawn_interval: float = 2.0
@export var linked_task_path: NodePath
@export var max_alive_monsters: int = 20
@export var auto_start: bool = true

var spawn_point: Node3D = null
var linked_task: RepairTask = null
var spawn_timer: float = 0.0
var spawning_active: bool = false

func _ready() -> void:
	if spawn_point_path != NodePath(""):
		spawn_point = get_node_or_null(spawn_point_path) as Node3D
	# 找不到指定刷怪点就用自己当刷怪点，绝对不为空
	if spawn_point == null:
		spawn_point = self
	if linked_task_path != NodePath(""):
		linked_task = get_node_or_null(linked_task_path) as RepairTask
	spawn_timer = base_spawn_interval
	spawning_active = auto_start

func _process(delta: float) -> void:
	if not spawning_active or monster_scene == null:
		return
	var current_interval: float = calculate_current_interval()
	spawn_timer -= delta
	if spawn_timer <= 0.0:
		spawn_monster()
		spawn_timer = current_interval

func calculate_current_interval() -> float:
	if linked_task == null:
		return base_spawn_interval
	var progress: float = linked_task.get_progress_percent()
	return lerp(base_spawn_interval, min_spawn_interval, progress)

func spawn_monster() -> void:
	var alive_monsters: Array = get_tree().get_nodes_in_group("monster")
	if alive_monsters.size() >= max_alive_monsters:
		return
	var monster: BaseMonster = monster_scene.instantiate() as BaseMonster
	get_tree().current_scene.add_child(monster)
	monster.global_position = spawn_point.global_position
